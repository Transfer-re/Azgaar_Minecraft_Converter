{
	"schemaVersion": 1,
	"id": "fantasymapgenerator",
	"version": "${version}",
	"name": "FantasyMapGenerator",
	"description": "Generates the overworld from an Azgaar's Fantasy Map Generator JSON export.",
	"authors": [
		"transferre"
	],
	"contact": {
		"homepage": "https://github.com/Transfer-re/Azgaar_Minecraft_Converter",
		"sources": "https://github.com/Transfer-re/Azgaar_Minecraft_Converter"
	},
	"license": "CC0-1.0",
	"icon": "assets/fantasymapgenerator/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.FantasyMapGenerator"
		],
		"client": [
			"com.example.FantasyMapGeneratorClient"
		],
		"fabric-datagen": [
			"com.example.FantasyMapGeneratorDataGenerator"
		]
	},
	"mixins": [
		"fantasymapgenerator.mixins.json",
		{
			"config": "fantasymapgenerator.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}